#!/usr/bin/env python3
"""
Emit a terminal BEL for AI-tool notifications.

Default mode writes Claude Code hook JSON with terminalSequence. The --raw mode
writes BEL directly for shell functions and OpenCode plugins.
"""
import json, sys

if "--raw" in sys.argv[1:]:
    sys.stdout.write("\x07")
else:
    # Claude Code parses terminalSequence and emits the escape sequence through
    # its own terminal write path. BEL triggers Zed's tab activity indicator.
    sys.stdout.write(json.dumps({"terminalSequence": "\x07"}))
